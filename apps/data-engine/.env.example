# Copy to apps/data-engine/.env. Each KEY=value line is read literally; file values override inherited environment variables of the same name.
# This is separate from the Node root .env; neither overrides the other.

POSTGRE_JDBC_URL=jdbc:postgresql://localhost:5432/datarag
POSTGRE_USER_NAME=ontomato
POSTGRE_PASSWORD=ontomato
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18087
BACKEND_SERVICE_ID=local-dev

# Fill in as needed; this repository provides no addresses or credentials.
# BACKEND_LLM_BASE_URL=
# BACKEND_LLM_API_KEY=
# BACKEND_LLM_MODEL=
# BACKEND_EMBEDDING_BASE_URL=
# BACKEND_EMBEDDING_API_KEY=
# BACKEND_EMBEDDING_MODEL=
# BACKEND_EMBEDDING_DIMENSIONS=
