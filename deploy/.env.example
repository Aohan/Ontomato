# Copy to .env and replace the placeholders. No real secrets.

# The architecture of this machine: amd64 or arm64. The offline bundle sets it to match
# the images under images/; do not change it there.
ARCH=amd64

# 1. Required. Without these the stack does not start, or the browser cannot open it.
# Letters, digits, ".", "_" and "-" only: it is copied into the Node DATABASE_URL without percent-encoding.
POSTGRES_PASSWORD=change-me
# The address the browser uses to reach this server: an IP address or a hostname.
PUBLIC_HOST=127.0.0.1

# 2. Models. Leave them unset to use the built-in defaults and configure them on
# the page after startup; these are only the initial values for a new domain.
# Do not set an empty string.
# BACKEND_LLM_BASE_URL=
# BACKEND_LLM_API_KEY=
# BACKEND_LLM_MODEL=
# BACKEND_EMBEDDING_BASE_URL=
# BACKEND_EMBEDDING_API_KEY=
# BACKEND_EMBEDDING_MODEL=

# 3. Fixed after the first start. It sets the vector table dimension and must
# match the embedding model's output; changing it once data exists breaks startup.
# BACKEND_EMBEDDING_DIMENSIONS=2048

# 4. Optional. Each entry below has a default; uncomment one to override it.
# Container ports are fixed: Node 3000, the manager 80, DataRAG 18087, PostgreSQL 5432.
# PORT=3000
# ONTOLOGY_MANAGER_PORT=3005
# DATARAG_PORT=18087
# POSTGRES_PORT=5432
# TZ=Asia/Shanghai
# COMPOSE_PROJECT_NAME=ontomato
# Release to pull with docker-compose.ghcr.yml, such as 4.0.0-beta.1; defaults to latest.
# ONTOMATO_VERSION=latest
# ONTOLOGY_INITIAL_ROUTE=/playground
# Defaults to http://PUBLIC_HOST:ONTOLOGY_MANAGER_PORT; override it for a domain or reverse proxy.
# ONTOLOGY_MANAGER_URL=

# Only when this deployment serves as the test environment of the
# ontomato-app-builder skill: the production backend URL (for example
# http://prod-host:18087) and an account used to log in to it;
# leave the account empty when production is an open-source deployment.
# BACKEND_PRODUCTION_ENV_URL=
# BACKEND_PRODUCTION_ENV_USER=
# BACKEND_PRODUCTION_ENV_PASSWORD=
