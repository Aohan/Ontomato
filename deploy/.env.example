# Copy to .env and replace the placeholders. No real secrets.
# One ARCH for every image: amd64 or arm64.

COMPOSE_PROJECT_NAME=ontomato
ARCH=amd64

# Host ports. Inside the containers Node stays on 3000, the manager on 80,
# DataRAG on 18087 and Postgres on 5432.
PORT=3000
ONTOLOGY_MANAGER_PORT=3005
DATARAG_PORT=18087
POSTGRES_PORT=5432

# Shared by Postgres, the Node URL, and DataRAG.
# Letters, digits, ".", "_", and "-" only. The Node URL is not percent-encoded.
POSTGRES_USER=ontomato
POSTGRES_PASSWORD=change-me

TZ=Asia/Shanghai

# Opened by the browser. Not a container DNS name.
# Keep it aligned with ONTOLOGY_MANAGER_PORT.
ONTOLOGY_MANAGER_URL=http://127.0.0.1:3005
ONTOLOGY_INITIAL_ROUTE=/playground

# The process starts when these are unset. The first visit to a domain copies
# them into that domain's business_config; the page then edits that database row.
# Do not set BACKEND_EMBEDDING_DIMENSIONS empty: an empty string replaces 2048.
BACKEND_LLM_BASE_URL=http://llm.example:8000/v1
BACKEND_LLM_API_KEY=llm-api-key
BACKEND_LLM_MODEL=llm-model
BACKEND_EMBEDDING_BASE_URL=http://embedding.example:8000/v1
BACKEND_EMBEDDING_API_KEY=embedding-api-key
BACKEND_EMBEDDING_MODEL=embedding-model
BACKEND_EMBEDDING_DIMENSIONS=2048

# Relational adapter. Business connections are per domain on the page.
# The datarag database is the product store, not that business database.
BACKEND_DATA_ADAPTER=postgresql

# Only when this deployment serves as the test environment of the
# ontomato-app-builder skill: the production backend URL (for example
# http://prod-host:18087) and an account used to log in to it;
# leave the account empty when production is an open-source deployment.
# BACKEND_PRODUCTION_ENV_URL=
# BACKEND_PRODUCTION_ENV_USER=
# BACKEND_PRODUCTION_ENV_PASSWORD=
