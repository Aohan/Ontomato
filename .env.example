# Copy to .env and adjust for this machine. Node reads this file (the process environment
# takes priority); Java reads apps/data-engine/.env.

# Node → DataRAG, and the target of the Ontology Manager's development proxy. There is no
# built-in default, so it must be set.
DATA_QUERY_BASE_URL=http://localhost:18087
DATARAG_ORIGIN=http://localhost:18087

# The default database connection works (apps/workbench falls back to
# ontomato:ontomato@localhost:5432/ontomato). Override it together only when DB_PORT in
# dev/postgres.compose.yml changes:
# DATABASE_URL=postgresql://ontomato:ontomato@localhost:5432/ontomato

# The system MCP is empty by default.
# MCP_SERVER_URL=

# Configure models in Model Configuration; Node reads the data engine's model settings.
